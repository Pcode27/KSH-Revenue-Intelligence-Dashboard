# Copy to .env and fill in. .env and the key file are git-ignored.
SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_USER=your_user
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=HOSPITALS
SNOWFLAKE_SCHEMA=REPORTING
# Path to the RSA private key (absolute, or relative to this repo root).
SNOWFLAKE_PRIVATE_KEY_PATH=rsa_key.p8
